              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenVet}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{javaUrl}}/api/pets",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Thor\",\n  \"especie\": \"Cachorro\",\n  \"raca\": \"Beagle\",\n  \"dataNascimento\": \"2022-05-10\",\n  \"peso\": 12.5,\n  \"genero\": \"Macho\",\n  \"responsavelCpf\": \"{{cpf}}\",\n  \"veterinarioResponsavelId\": {{vetId}}\n}"
            }
