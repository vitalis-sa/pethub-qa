        {
          "name": "Responsável lista os pets pelo gateway do .NET",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenResp}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{dotnetUrl}}/api/clinico/pets"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200 OK\", () => pm.response.to.have.status(200));",
                  "const corpo = pm.response.json();",
                  "const pets = Array.isArray(corpo) ? corpo : (corpo.content || corpo.itens || []);",
                  "pm.test(\"Lista tem exatamente 1 pet, o Thor\", () => {",
                  "  pm.expect(pets).to.have.lengthOf(1);",
                  "  pm.expect(pets[0].nome).to.eql(\"Thor\");",
                  "});",
                  "pm.test(\"Responde em menos de 5 s\", () => pm.expect(pm.response.responseTime).to.be.below(5000));"
                ]
              }
            }
          ]
