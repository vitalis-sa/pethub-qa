{
  "info": {
    "name": "PetHub - Automação de Testes (Sprint 4)",
    "description": "Testes de integração das APIs do PetHub: Vitalis (.NET, responsável) e pethub-java (clínico). Cada caso AT corresponde a um Test Case do plano manual no Azure DevOps. Rode pelo Collection Runner, na ordem.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "dotnetUrl",
      "value": "https://pethub-dotnet.cloud.run"
    },
    {
      "key": "javaUrl",
      "value": "https://pethub-java.cloud.run"
    },
    {
      "key": "senha",
      "value": "Teste@123"
    }
  ],
  "item": [
    {
      "name": "00 - Preparação (veterinário e unidade)",
      "item": [
        {
          "name": "Registrar veterinário de teste",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{javaUrl}}/api/auth/registrar/veterinario",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Dra. Qa Automacao\",\n  \"crmv\": \"{{crmv}}\",\n  \"especialidade\": \"Clínica geral\",\n  \"email\": \"{{emailVet}}\",\n  \"senha\": \"{{senha}}\",\n  \"ativo\": true\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const s = Date.now().toString();",
                  "pm.collectionVariables.set(\"sufixo\", s);",
                  "pm.collectionVariables.set(\"emailVet\", \"vet.qa.\" + s + \"@pethub.teste\");",
                  "pm.collectionVariables.set(\"crmv\", \"SP-\" + s.slice(-6));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Veterinário criado (201)\", () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
                  "const c = pm.response.json();",
                  "pm.collectionVariables.set(\"tokenVet\", c.token);",
                  "pm.collectionVariables.set(\"vetId\", c.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Criar unidade veterinária",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenVet}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{javaUrl}}/api/unidades",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"veterinarioId\": {{vetId}},\n  \"nome\": \"PetHub QA Paulista\",\n  \"logradouro\": \"Av. Paulista\",\n  \"numero\": \"1106\",\n  \"bairro\": \"Bela Vista\",\n  \"cidade\": \"São Paulo\",\n  \"estado\": \"SP\",\n  \"cep\": \"01311000\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Unidade criada (201)\", () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
                  "pm.collectionVariables.set(\"unidadeId\", pm.response.json().id);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "AT01 - Cadastro do responsável",
      "item": [
        {
          "name": "Cadastrar responsável",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{dotnetUrl}}/api/responsavel/cadastro",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Ana Qa Automacao\",\n  \"cpf\": \"{{cpf}}\",\n  \"email\": \"{{emailResp}}\",\n  \"senha\": \"{{senha}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// CPF válido gerado a cada execução, para a coleção rodar várias vezes sem limpar o banco",
                  "const n = Array.from({ length: 9 }, () => Math.floor(Math.random() * 10));",
                  "const dv = (arr) => { const r = arr.reduce((s, d, i) => s + d * (arr.length + 1 - i), 0) % 11; return r < 2 ? 0 : 11 - r; };",
                  "n.push(dv(n)); n.push(dv(n));",
                  "const s = Date.now().toString();",
                  "pm.collectionVariables.set(\"cpf\", n.join(\"\"));",
                  "pm.collectionVariables.set(\"emailResp\", \"resp.qa.\" + s + \"@pethub.teste\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201 Created\", () => pm.response.to.have.status(201));",
                  "const c = pm.response.json();",
                  "pm.test(\"Devolve id, nome, e-mail e token\", () => {",
                  "  pm.expect(c.id).to.be.a(\"number\");",
                  "  pm.expect(c.nome).to.eql(\"Ana Qa Automacao\");",
                  "  pm.expect(c.email).to.eql(pm.collectionVariables.get(\"emailResp\"));",
                  "  pm.expect(c.token.split(\".\")).to.have.lengthOf(3);",
                  "});",
                  "pm.test(\"Senha nunca volta na resposta\", () => pm.expect(pm.response.text()).to.not.include(pm.collectionVariables.get(\"senha\")));",
                  "pm.test(\"Responde em menos de 5 s\", () => pm.expect(pm.response.responseTime).to.be.below(5000));",
                  "pm.collectionVariables.set(\"responsavelId\", c.id);",
                  "pm.collectionVariables.set(\"tokenResp\", c.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Cadastrar o mesmo e-mail de novo (conflito)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{dotnetUrl}}/api/responsavel/cadastro",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Ana Duplicada\",\n  \"cpf\": \"11144477735\",\n  \"email\": \"{{emailResp}}\",\n  \"senha\": \"{{senha}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"E-mail duplicado é recusado com 409\", () => pm.response.to.have.status(409));",
                  "pm.test(\"Resposta não traz token\", () => pm.expect(pm.response.text()).to.not.include(\"token\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "AT02 - Login válido do responsável (Azure 170)",
      "item": [
        {
          "name": "Login com e-mail e senha corretos",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{dotnetUrl}}/api/responsavel/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{emailResp}}\",\n  \"senha\": \"{{senha}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200 OK\", () => pm.response.to.have.status(200));",
                  "const c = pm.response.json();",
                  "pm.test(\"Token JWT no formato cabeçalho.corpo.assinatura\", () => pm.expect(c.token.split(\".\")).to.have.lengthOf(3));",
                  "pm.test(\"Sessão é do responsável cadastrado\", () => pm.expect(c.id).to.eql(Number(pm.collectionVariables.get(\"responsavelId\"))));",
                  "pm.test(\"Responde em menos de 5 s\", () => pm.expect(pm.response.responseTime).to.be.below(5000));",
                  "pm.collectionVariables.set(\"tokenResp\", c.token);"
                ]
              }
            }
          ]
        }
      ]
    },
