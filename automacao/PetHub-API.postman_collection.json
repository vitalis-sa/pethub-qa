    {
      "name": "AT05 - Agendamento e conflito de horário (Azure 246)",
      "item": [
        {
          "name": "Responsável agenda consulta em horário livre",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenResp}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{dotnetUrl}}/api/clinico/consultas",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dataHora\": \"{{dataConsulta}}\",\n  \"observacoes\": \"Check-up antes de viagem\",\n  \"status\": \"AGENDADA\",\n  \"petId\": {{petId}},\n  \"veterinarioId\": {{vetId}},\n  \"unidadeId\": {{unidadeId}}\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = new Date(Date.now() + 3 * 86400000);",
                  "d.setUTCHours(13 + Math.floor(Math.random() * 6), [0, 15, 30, 45][Math.floor(Math.random() * 4)], 0, 0);",
                  "pm.collectionVariables.set(\"dataConsulta\", d.toISOString().slice(0, 19));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Consulta criada (201)\", () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
                  "const c = pm.response.json();",
                  "pm.test(\"Consulta nasce AGENDADA para o pet Thor\", () => {",
                  "  pm.expect(c.status).to.eql(\"AGENDADA\");",
                  "  pm.expect(String(c.petId ?? (c.pet && c.pet.id))).to.eql(String(pm.collectionVariables.get(\"petId\")));",
                  "});",
                  "pm.test(\"Responde em menos de 5 s\", () => pm.expect(pm.response.responseTime).to.be.below(5000));",
                  "pm.collectionVariables.set(\"consultaId\", c.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Mesmo veterinário, mesmo horário",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenResp}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{dotnetUrl}}/api/clinico/consultas",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dataHora\": \"{{dataConsulta}}\",\n  \"observacoes\": \"Vacinação\",\n  \"status\": \"AGENDADA\",\n  \"petId\": {{petId}},\n  \"veterinarioId\": {{vetId}}\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Horário ocupado é recusado com 409\", () => pm.response.to.have.status(409));",
                  "pm.test(\"Mensagem fala do conflito de agenda\", () => pm.expect(pm.response.text()).to.include(\"já tem uma consulta marcada\"));"
                ]
              }
            }
          ]
        }
      ]
