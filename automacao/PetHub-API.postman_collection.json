            "url": "{{dotnetUrl}}/api/responsavel/{{responsavelId}}/enderecos"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200 OK\", () => pm.response.to.have.status(200));",
                  "const corpo = pm.response.json();",
                  "const lista = Array.isArray(corpo) ? corpo : (corpo.itens || corpo.items || corpo.dados || []);",
                  "pm.test(\"Há 2 endereços e só 1 é principal\", () => {",
                  "  pm.expect(lista).to.have.lengthOf(2);",
                  "  pm.expect(lista.filter(e => e.principal)).to.have.lengthOf(1);",
                  "});",
                  "pm.test(\"O principal é o segundo endereço\", () => {",
                  "  pm.expect(lista.find(e => e.principal).id).to.eql(Number(pm.collectionVariables.get(\"endereco2Id\")));",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
