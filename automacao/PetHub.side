          "id": "024c2511-b688-453a-8b1c-da0ed87a37b6",
          "comment": "CPF válido e único por execução",
          "command": "executeScript",
          "target": "var n=[];for(var i=0;i<9;i++){n.push(Math.floor(Math.random()*10));}for(var k=9;k<11;k++){var s=0;for(var j=0;j<k;j++){s+=n[j]*(k+1-j);}n.push((s*10)%11%10);}return n.join('');",
          "targets": [],
          "value": "cpf"
        },
