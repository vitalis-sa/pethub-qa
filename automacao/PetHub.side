      "commands": [
        {
          "id": "0d6a07bf-d560-43f3-9f5b-9832ca588b25",
          "comment": "Horário futuro aleatório, livre",
          "command": "executeScript",
          "target": "var d=new Date(Date.now()+(60+Math.floor(Math.random()*600))*86400000);var p=function(x){return (x<10?'0':'')+x;};return d.getFullYear()+'-'+p(d.getMonth()+1)+'-'+p(d.getDate())+'T'+p(8+Math.floor(Math.random()*10))+':'+p(Math.floor(Math.random()*12)*5);",
          "targets": [],
          "value": "horario"
        },
